VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel Serverless Function secrets for Social Plan AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vercel Serverless Function secret for Email tab (Hostinger IMAP + SMTP),
# also used by the local MCP server in mcp/hostinger-mail.
# JSON array of mailboxes, e.g.:
# [{"key":"info","label":"Info","host":"imap.hostinger.com","port":993,"user":"info@domain.com","password":"..."}]
# Optional per-mailbox smtpHost/smtpPort fields (default: host with "imap." swapped for "smtp.", port 465)
# enable sending replies/forwards.
HOSTINGER_MAILBOXES=

# Supabase Edge Function secrets
N8N_TASK_CALENDAR_WEBHOOK_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=
APP_URL=
